# When this stack runs in Spacelift, the values below are supplied automatically:
#   vpc_id, public_subnet_ids, certificate_arn         -> from Phase 1 stack dependency
#   p4_super_user_username_secret_arn                   -> from Phase 1 stack dependency
#   p4_super_user_password_secret_arn                   -> from Phase 1 stack dependency
#   github_credentials_secret_arn, agent_ami_id, etc.   -> from Spacelift env vars
#
# Only fill out the values below for local runs.

aws_region                  = "us-east-1"
route53_subdomain_zone_name = "studio.sidewinder.dev"

vpc_id            = "vpc-XXXXXXXXXXXXXXXXX"
public_subnet_ids = ["subnet-XXXXXXXXXXXXXXXXX", "subnet-YYYYYYYYYYYYYYYYY"]
certificate_arn   = "arn:aws:acm:us-east-1:622709063820:certificate/XXXXXXXX-XXXX-XXXX-XXXX-XXXXXXXXXXXX"

github_credentials_secret_arn     = "arn:aws:secretsmanager:us-east-1:622709063820:secret:sidewinder/ghcr-credentials-XXXXXX"
p4_super_user_username_secret_arn = "arn:aws:secretsmanager:us-east-1:622709063820:secret:sidewinder-p4-server-admin-username-XXXXXX"
p4_super_user_password_secret_arn = "arn:aws:secretsmanager:us-east-1:622709063820:secret:sidewinder-p4-server-super-password-XXXXXX"

agent_ami_id             = "ami-XXXXXXXXXXXXXXXXX"
agent_max_size           = 3
agent_workspace_size_gib = 1024
agent_pool_name          = "linux-ue-builder"

admin_cidrs              = []
horde_host_instance_type = "t4g.medium"
horde_data_volume_size   = 100
