#!/bin/bash
set -euxo pipefail

REGION="${region}"
SECRET_NAME="${secret_name}"
HOSTNAME="${hostname}"
ADVERTISE_ROUTES="${advertise_routes}"
ADVERTISE_TAGS="${advertise_tags}"
ENABLE_SSH="${enable_ssh}"

dnf install -y dnf-plugins-core jq
dnf config-manager --add-repo https://pkgs.tailscale.com/stable/amazon-linux/2023/tailscale.repo
dnf install -y tailscale

systemctl enable --now tailscaled

cat > /etc/sysctl.d/99-tailscale.conf <<EOF
net.ipv4.ip_forward = 1
net.ipv6.conf.all.forwarding = 1
EOF
sysctl -p /etc/sysctl.d/99-tailscale.conf

# Wait for IMDSv2 to be reachable for the AWS CLI
for i in $(seq 1 30); do
  if curl -sf -o /dev/null --max-time 2 \
    -H "X-aws-ec2-metadata-token: $(curl -s -X PUT 'http://169.254.169.254/latest/api/token' -H 'X-aws-ec2-metadata-token-ttl-seconds: 60')" \
    http://169.254.169.254/latest/meta-data/iam/security-credentials/; then
    break
  fi
  sleep 2
done

AUTH=$(aws --region "$REGION" secretsmanager get-secret-value --secret-id "$SECRET_NAME" --query SecretString --output text)

SSH_FLAG=""
if [ "$ENABLE_SSH" = "true" ]; then
  SSH_FLAG="--ssh"
fi

tailscale up \
  --authkey="$AUTH" \
  --hostname="$HOSTNAME" \
  --advertise-routes="$ADVERTISE_ROUTES" \
  --advertise-tags="$ADVERTISE_TAGS" \
  --accept-dns=false \
  $SSH_FLAG

tailscale status
