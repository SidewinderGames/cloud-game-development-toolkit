services:
  mongo:
    image: mongo:7.0
    restart: unless-stopped
    network_mode: host
    command:
      - mongod
      - --bind_ip
      - "127.0.0.1"
      - --wiredTigerCacheSizeGB
      - "${mongo_max_cache_g}"
      - --quiet
    env_file: /etc/horde/mongo.env
    volumes:
      - /var/lib/horde-data/mongo:/data/db
    healthcheck:
      test: ["CMD", "mongosh", "--quiet", "--eval", "db.adminCommand('ping')"]
      interval: 10s
      retries: 6
      start_period: 30s

  redis:
    image: redis:7.2-alpine
    restart: unless-stopped
    network_mode: host
    command:
      - redis-server
      - --bind
      - "127.0.0.1"
      - --maxmemory
      - "${redis_maxmemory}"
      - --maxmemory-policy
      - "allkeys-lru"
      - --save
      - "60"
      - "1"
    volumes:
      - /var/lib/horde-data/redis:/data
    healthcheck:
      test: ["CMD", "redis-cli", "-h", "127.0.0.1", "ping"]
      interval: 10s
      retries: 6

  horde:
    image: ${horde_image}
    restart: unless-stopped
    network_mode: host
    env_file: /etc/horde/horde.env
    volumes:
      - /var/lib/horde-data/horde:/app/Data
      - /etc/horde/server-config:/app/server-config:ro
    depends_on:
      mongo:
        condition: service_healthy
      redis:
        condition: service_healthy
    healthcheck:
      test: ["CMD-SHELL", "curl -fsS http://127.0.0.1:${api_port}/health/ok || exit 1"]
      interval: 30s
      retries: 5
      start_period: 60s
