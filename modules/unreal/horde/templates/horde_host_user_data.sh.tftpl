#!/bin/bash
set -euxo pipefail

REGION="${region}"
GHCR_SECRET_ARN="${ghcr_credentials_secret_arn}"
MONGO_USER="${mongo_username}"
MONGO_PWD_SECRET_ARN="${mongo_password_secret_arn}"
P4_USER_SECRET_ARN="${p4_super_user_username_secret_arn}"
P4_PWD_SECRET_ARN="${p4_super_user_password_secret_arn}"

dnf install -y docker jq

mkdir -p /usr/libexec/docker/cli-plugins
curl -sSL -o /usr/libexec/docker/cli-plugins/docker-compose \
  "https://github.com/docker/compose/releases/download/v2.29.7/docker-compose-linux-x86_64"
chmod +x /usr/libexec/docker/cli-plugins/docker-compose

systemctl enable --now docker
usermod -aG docker ec2-user

%{ if mount_data_volume ~}
for i in $(seq 1 60); do
  if [ -b /dev/nvme1n1 ]; then break; fi
  sleep 2
done

if ! blkid /dev/nvme1n1; then
  mkfs.xfs -L horde-data /dev/nvme1n1
fi

mkdir -p /var/lib/horde-data
grep -q '/var/lib/horde-data' /etc/fstab || \
  echo "LABEL=horde-data /var/lib/horde-data xfs defaults,nofail 0 2" >> /etc/fstab
mount -a
%{ else ~}
# No separate data volume - Mongo + Redis + Horde state live on the root disk.
# Safe once horde-artifacts and horde-logs namespaces are routed to S3 (the only
# meaningful local consumer is Mongo, which stays well under a GB at this scale).
mkdir -p /var/lib/horde-data
%{ endif ~}

mkdir -p /var/lib/horde-data/mongo /var/lib/horde-data/redis /var/lib/horde-data/horde
chown -R 999:999 /var/lib/horde-data/mongo
chmod 700 /var/lib/horde-data/mongo

mkdir -p /etc/horde

if [ -n "$GHCR_SECRET_ARN" ]; then
  GHCR_JSON=$(aws --region "$REGION" secretsmanager get-secret-value --secret-id "$GHCR_SECRET_ARN" --query SecretString --output text)
  GHCR_USER=$(echo "$GHCR_JSON" | jq -r .username)
  GHCR_PASS=$(echo "$GHCR_JSON" | jq -r .password)
  echo "$GHCR_PASS" | docker login ghcr.io -u "$GHCR_USER" --password-stdin
fi

# Install amazon-ecr-credential-helper and wire it into docker config so
# docker pulls from ECR auto-refresh the auth token. Without this, the
# 12h ECR token expires and any subsequent `docker compose pull` (e.g.
# the one in horde-compose.service on boot) fails with "authorization
# token has expired", leaving the container stack down until someone
# re-runs ecr get-login-password by hand.
ECR_REGISTRY=$(echo "${horde_image}" | awk -F/ '{print $1}')
if echo "$ECR_REGISTRY" | grep -q '\.dkr\.ecr\.'; then
  dnf install -y amazon-ecr-credential-helper
  mkdir -p /root/.docker
  cat >/root/.docker/config.json <<EOF
{
  "credHelpers": {
    "$${ECR_REGISTRY}": "ecr-login"
  }
}
EOF
  # Prime the cache so the first pull doesn't pay the IMDS round trip.
  # Tolerate failure: the helper's Store returns "not implemented" (by design - it
  # fetches fresh tokens via IMDS rather than caching), which makes `docker login`
  # exit non-zero even though auth succeeded. Without `|| true` this aborts the
  # whole user-data script under `set -e`, leaving the host with no /etc/horde/*
  # files and no compose stack.
  aws --region "$REGION" ecr get-login-password | docker login --username AWS --password-stdin "$ECR_REGISTRY" || true
fi

MONGO_PWD=$(aws --region "$REGION" secretsmanager get-secret-value --secret-id "$MONGO_PWD_SECRET_ARN" --query SecretString --output text)

umask 077
cat >/etc/horde/mongo.env <<EOF
MONGO_INITDB_ROOT_USERNAME=$${MONGO_USER}
MONGO_INITDB_ROOT_PASSWORD=$${MONGO_PWD}
EOF

cat >/etc/horde/horde.env <<EOF
Horde__databaseConnectionString=mongodb://$${MONGO_USER}:$${MONGO_PWD}@127.0.0.1:27017/?directConnection=true
Horde__redisConnectionConfig=127.0.0.1:6379
Horde__jwtIssuer=https://${fqdn}
Horde__httpPort=${api_port}
Horde__httpsPort=0
Horde__http2Port=${grpc_port}
# Single-host deploys need both runModes; the Worker side owns the periodic
# config poll (PerforceConfigSource) and ticker-driven background tasks.
Horde__runModes__0=Server
Horde__runModes__1=Worker
${horde_env_lines}
EOF

if [ -n "$P4_USER_SECRET_ARN" ]; then
  P4_USER=$(aws --region "$REGION" secretsmanager get-secret-value --secret-id "$P4_USER_SECRET_ARN" --query SecretString --output text)
  P4_PWD=$(aws --region "$REGION" secretsmanager get-secret-value --secret-id "$P4_PWD_SECRET_ARN" --query SecretString --output text)
  # The secret value is a P4 ticket (generated with `p4 login -a -p`), not a
  # raw password; using the ticket field skips Horde's fresh `p4 login`
  # attempt (which would always fail against a ticket).
  cat >>/etc/horde/horde.env <<EOF
Horde__Perforce__0__credentials__username=$${P4_USER}
Horde__Perforce__0__credentials__ticket=$${P4_PWD}
EOF
fi

%{ if p4_trust_bucket != "" ~}
# Seed the P4 trust file the Horde server's libp4 reads. Without this the
# server's first FStat against the SSL Perforce server aborts startup with
# "The authenticity of <ip>:1666 can't be established". The container mounts
# /var/lib/horde-data/horde at /app/Data, and P4TRUST is set to /app/Data/.p4trust
# in horde.env, so the file must land at /var/lib/horde-data/horde/.p4trust on
# the host. Used to ride on the persistent data EBS; with that gone, refetch
# on every boot from the same S3 location the agents already use.
aws --region "$REGION" s3 cp s3://${p4_trust_bucket}/agent/.p4trust /var/lib/horde-data/horde/.p4trust
chmod 644 /var/lib/horde-data/horde/.p4trust
%{ endif ~}

cat >/etc/horde/docker-compose.yml <<'COMPOSE_EOF'
${docker_compose_yaml}
COMPOSE_EOF

cat >/etc/systemd/system/horde-compose.service <<'EOF'
[Unit]
Description=Horde Server compose stack
After=docker.service network-online.target
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/etc/horde
ExecStartPre=/usr/bin/docker compose pull
ExecStart=/usr/bin/docker compose up -d
ExecStop=/usr/bin/docker compose down

[Install]
WantedBy=multi-user.target
EOF

systemctl daemon-reload
systemctl enable --now horde-compose.service
